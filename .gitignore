# ---------------------------------------------------------------------------
# Unreal Engine 5.8 —— 生成物，不入库
# ---------------------------------------------------------------------------
/Binaries/
/Build/
/DerivedDataCache/
/Intermediate/
/Saved/
/Plugins/*/Binaries/
/Plugins/*/Intermediate/
/Shaders/*.ush.autogen

# ---------------------------------------------------------------------------
# 不随仓库分发的第三方/模板资源
#
# Content/Characters/Mannequins 是 UE5「Third Person」模板自带的 Manny/Quinn
# 角色资产（约 88 MB），不是本项目的成果，因此不入库 —— 否则公开仓库里会
# 塞进一堆 Epic 的模板内容，clone 体积也不划算。
#
# 本地工程里这些文件仍然存在（已从索引移除、未从磁盘删除），所以编辑器里一切正常。
# 重新获取方式：用同版本引擎新建一个「Third Person」模板工程，
# 把它 Content/Characters/Mannequins 整个目录拷回来即可。
# ---------------------------------------------------------------------------
/Content/Characters/Mannequins/

# ---------------------------------------------------------------------------
# IDE / 构建系统生成
# ---------------------------------------------------------------------------
/.vs/
/.vscode/
/.idea/
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.opendb
*.tmp
/Automation_*.sln
/Automation_*.slnx

# ---------------------------------------------------------------------------
# Python（Scripts/ 下的脚本要入库，缓存不要）
# ---------------------------------------------------------------------------
__pycache__/
*.pyc

# ---------------------------------------------------------------------------
# 操作系统
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
