# 统一换行，避免 Windows/Unix 混用产生整文件 diff
* text=auto

# Unreal 资产是二进制，禁止任何文本处理/合并
*.uasset  binary
*.umap    binary
*.ubulk   binary
*.uexp    binary
*.upk     binary
*.udk     binary
*.pak     binary
*.utoc    binary
*.ucas    binary
*.sig     binary

# 常见资源
*.png     binary
*.jpg     binary
*.exr     binary
*.hdr     binary
*.wav     binary
*.fbx     binary
*.ttf     binary
*.dll     binary
*.lib     binary
*.pdb     binary
