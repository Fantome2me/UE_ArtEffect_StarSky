// Copyright (c) 2026. Star Sky / Aurora / Nebula sky for UE.
//
// 逐行直译自 Unity 版 Assets/StarNestSkybox.shader（内部名 Skybox/AuroraStarNest）。
// 参数与颜色以 **方案文档 v2 的「材质实际」值** 为准（不是 shader 默认值）。
//
// 入口：MainCS —— 一个 thread 计算一个 texel。
// cube 以 Texture2DArray 方式绑定 UAV（6 个 slice = 6 个面），一次 dispatch 覆盖全部 6 面，
// dispatch 的 Z 维 = face index。
//
// ---------------------------------------------------------------------------
// 性能约定：**所有天空参数都是编译期常量**，运行时只有 3 个 uniform：
//   RWOutput (UAV) / CubeSize / SkyTime
// 这样循环上界是字面量（可被编译器优化/SIMD 化），颜色与系数被折成立即数，
// 且 AutoRotate = 0 让两处旋转矩阵的 cos/sin 在编译期算完。
// 要改画面观感就改下面的 #define / static const —— 它们和文档 §3.1、§3.2 一一对应。
// ---------------------------------------------------------------------------

#include "/Engine/Private/Common.ush"

// ===========================================================================
// 运行时 uniform（只有这 4 个）
// ===========================================================================
RWTexture2DArray<float4> RWOutput;

uint  CubeSize;
/** 本次 dispatch 从第几个面开始（按面调度用：一次只烘 1~N 个面） */
uint  CubeFaceBase;
float SkyTime;

// ===========================================================================
// 编译期常量 —— 方案 v2 §3.1 数值参数表
// ===========================================================================

/** 体积步进（原材质 28；降到 24 换取 ~14% 星云成本，层次变化极小） */
#define NTA_VOLSTEPS        24
/** 分形迭代（材质实际 16.3 → int 截断 16）。 */
#define NTA_ITERATIONS      16
/**
 * 极光层数。
 *
 * 原版 50 层；这里降到 32。极光占全部 ALU 约六成，层数线性放大成本，
 * 而层间距极小（层高差 pow(i,1.4)*0.002，在 32 层时相邻层差 < 0.01），
 * 减到 32 视觉上几乎看不出来。
 */
#define NTA_AURORA_LAYERS   32

/** 0 = 完整。诊断用：1 仅星云 / 2 仅星星 / 3 仅极光 / 4 亮度灰度 / 5 仅地平线下雾 */
#define NTA_DEBUG_MODE      0

/**
 * 地平线以下那层「地面雾」（带噪声的蓝灰加法，原始 Unity shader 里的 else 分支）。
 *
 *   0 = 关闭（当前）：地平线以下只保留极光镜像后的星云与星星，画面是干净的星空
 *   1 = 打开（原版行为）
 *
 * 关掉的原因：这层雾是「加法 + 92% 变暗」双重衰减后的结果，最大贡献只有约 0.017 线性值，
 * 却会在地平线以下铺一层灰蓝色调，让下半球看起来"发闷"。而本工程的地平线以下
 * 绝大多数时候被关卡几何挡住，只有从高处往下看越过关卡边缘时才露出来。
 */
#define NTA_GROUND_FOG      0

/** 形态最关键参数（0.53 ± 0.1 变化明显） */
static const float NTA_FORMUPARAM     = 0.53f;
static const float NTA_STEPSIZE       = 0.1f;
/** ★ v2 关键修正：材质实际是 15.2，不是 0.8（构图完全不同） */
static const float NTA_ZOOM           = 15.2f;
/** 瓷砖折叠尺度 */
static const float NTA_TILE           = 0.75f;
/** ★ v2：负值 —— 反向演化 */
static const float NTA_SPEED          = -0.05f;
static const float NTA_BRIGHTNESS     = 0.0015f;
/** 暗物质（遮挡对比），材质实际 0.43 */
static const float NTA_DARKMATTER     = 0.43f;
static const float NTA_DISTFADING     = 0.7f;
static const float NTA_SATURATION     = 0.85f;

/** ★ v2：AutoRotate = 0 —— 整体不自转，构图固定 */
static const float NTA_A1 = 0.5f;   // = 0.5 + AutoRotate * t * 0.1，AutoRotate = 0
static const float NTA_A2 = 0.8f;   // = 0.8 + AutoRotate * t * 0.05

/** 极光速度总控（材质 _TimeScale = 0.735），内部 ×25 */
static const float NTA_AURORA_TIME_SCALE = 0.735f;
static const float NTA_AURORA_EXPOSURE   = 1.175f;
static const float NTA_AURORA_HEIGHT     = 0.823f;

static const float NTA_STAR_INTENSITY = 2.0f;

/** ★★★★★ v2 最重要的一条：92% 变暗 —— 最终亮度只有计算值的 8% */
static const float NTA_SKY_DARKEN = 0.92f;
static const float3 NTA_SKY_DARKEN_COLOR = float3(0.0f, 0.0f, 0.0f);

/** 原 shader 里写死的 ro，决定星云视角与极光层求交位置 */
static const float3 NTA_RAY_ORIGIN = float3(0.0f, 0.0f, -6.7f);

// 颜色：方案 v2 §3.2 的 **Linear 列**（UE 的向量参数是线性，直接填 sRGB 会偏亮偏粉）
static const float3 NTA_AURORA_COLOR1   = float3(0.158f, 0.000f, 0.078f);   // sRGB(0.434,0,0.309) 暗紫红
static const float3 NTA_AURORA_COLOR2   = float3(1.000f, 0.317f, 0.746f);   // sRGB(1,0.599,0.879) 粉紫
static const float3 NTA_NEBULA_COLOR    = float3(1.000f, 0.033f, 0.748f);   // sRGB(1,0.2,0.88)   品红
static const float3 NTA_HIGHLIGHT_COLOR = float3(0.494f, 0.962f, 1.000f);   // sRGB(0.731,0.983,1) 青白
static const float3 NTA_DARK_COLOR      = float3(0.096f, 0.007f, 0.323f);   // sRGB(0.343,0.077,0.604) 深紫暗底

// ---------------------------------------------------------------------------
// 极光每层常量查表
//
// 原版在 50 层循环里每层现算 4 个超越函数（pow / sin / exp2 / sin(Hash21)）
// 加上一次颜色 lerp —— 每 texel 约 200 次超越函数，占总 ALU 的一到两成。
// 这些量**只依赖层号 i、与像素无关**，所以全部预先算好放进常量数组：
//
//   PT_BIAS[i]   = pow(i, 1.4) * 0.002              （层高偏移）
//   OF[i]        = 0.006 * Hash21(i, i*2) * smoothstep(0,15,i)   （层抖动）
//   WEIGHT[i]    = exp2(-i*0.065 - 2.5) * smoothstep(0,5,i)      （高度衰减，两项合一）
//   COLOR[i]     = lerp(AuroraColor1, AuroraColor2, sin(i*0.05)*0.5+0.5)
//
// 由脚本按上面公式生成，数值与原先逐层现算完全一致（float32 精度内）。
// ---------------------------------------------------------------------------
static const float NTA_LAYER_PT_BIAS[NTA_AURORA_LAYERS] = {
	0.0f, 0.002f, 0.00527803164f, 0.00931107344f, 0.013928809f, 0.0190365394f, 0.0245720701f, 0.0304906899f,
	0.0367583474f, 0.0433480443f, 0.0502377286f, 0.05740897f, 0.0648460818f, 0.0725355133f, 0.0804654132f, 0.0886253082f,
	0.0970058603f, 0.105598679f, 0.114396175f, 0.123391441f, 0.132578161f, 0.141950527f, 0.15150318f, 0.161231155f,
	0.171129836f, 0.181194916f, 0.191422367f, 0.201808412f, 0.212349498f, 0.223042278f, 0.23388359f, 0.244870443f
};

static const float NTA_LAYER_OF[NTA_AURORA_LAYERS] = {
	0.0f, 7.14600072e-05f, 0.000284187927f, 0.000416028339f, 0.00103090084f, 0.0003612457f, 0.00118829006f, 0.00239701542f,
	0.000821404334f, 0.00210740123f, 0.00120397123f, 0.00367708767f, 0.0037427069f, 0.00560374526f, 0.000804396714f, 0.00570205946f,
	0.00283566796f, 0.00210189368f, 0.000747944658f, 0.00185905008f, 0.000224290647f, 0.00466901036f, 0.000921067795f, 0.00200641565f,
	0.0051355536f, 0.00178361043f, 0.00238978017f, 0.00513271323f, 0.0042929426f, 0.00555029702f, 0.00566481041f, 0.00572848317f
};

static const float NTA_LAYER_WEIGHT[NTA_AURORA_LAYERS] = {
	0.0f, 0.0175748408f, 0.0568635245f, 0.10006891f, 0.132271178f, 0.141120551f, 0.13490353f, 0.128960397f,
	0.123279088f, 0.117848067f, 0.112656308f, 0.10769327f, 0.102948877f, 0.0984134971f, 0.0940779217f, 0.0899333488f,
	0.0859713636f, 0.0821839225f, 0.0785633359f, 0.0751022531f, 0.0717936472f, 0.0686308009f, 0.0656072927f, 0.0627169843f,
	0.0599540075f, 0.0573127527f, 0.0547878576f, 0.0523741959f, 0.0500668673f, 0.0478611874f, 0.045752678f, 0.0437370583f
};

static const float3 NTA_LAYER_COLOR[NTA_AURORA_LAYERS] = {
	float3(0.579f, 0.1585f, 0.412f),
	float3(0.60004123f, 0.166421698f, 0.428693043f),
	float3(0.621029868f, 0.174323597f, 0.445344361f),
	float3(0.641913454f, 0.182185944f, 0.461912336f),
	float3(0.662639788f, 0.189989089f, 0.478355556f),
	float3(0.683157067f, 0.197713528f, 0.494632922f),
	float3(0.703414007f, 0.205339953f, 0.510703749f),
	float3(0.723359977f, 0.212849302f, 0.526527868f),
	float3(0.742945122f, 0.220222807f, 0.542065726f),
	float3(0.76212049f, 0.227442037f, 0.557278488f),
	float3(0.780838152f, 0.234488948f, 0.57212813f),
	float3(0.799051323f, 0.241345926f, 0.586577534f),
	float3(0.816714481f, 0.247995832f, 0.600590586f),
	float3(0.833783477f, 0.254422045f, 0.61413226f),
	float3(0.850215646f, 0.260608503f, 0.627168708f),
	float3(0.865969918f, 0.266539743f, 0.639667346f),
	float3(0.881006914f, 0.27220094f, 0.651596934f),
	float3(0.895289051f, 0.277577944f, 0.662927655f),
	float3(0.908780629f, 0.282657315f, 0.673631188f),
	float3(0.921447928f, 0.287426358f, 0.683680779f),
	float3(0.933259285f, 0.291873151f, 0.693051309f),
	float3(0.944185178f, 0.295986581f, 0.701719357f),
	float3(0.954198299f, 0.299756367f, 0.709663258f),
	float3(0.963273619f, 0.303173085f, 0.716863156f),
	float3(0.971388455f, 0.306228195f, 0.723301055f),
	float3(0.978522525f, 0.308914062f, 0.728960863f),
	float3(0.984657996f, 0.311223972f, 0.733828434f),
	float3(0.989779534f, 0.313152152f, 0.737891602f),
	float3(0.993874336f, 0.314693782f, 0.74114021f),
	float3(0.996932169f, 0.315845009f, 0.743566139f),
	float3(0.998945389f, 0.316602955f, 0.745163326f),
	float3(0.999908965f, 0.316965727f, 0.745927777f)
};

// ---------------------------------------------------------------------------
// 极大值保护：原 shader 在 rd.y 接近 0 时 pt 会数值爆炸（风险 R13）
// ---------------------------------------------------------------------------
#define NTA_EPS 1e-4f

// ===========================================================================
// 极光工具函数
// ===========================================================================

float2x2 NTA_MM2(float a)
{
	float c = cos(a), s = sin(a);
	return float2x2(c, s, -s, c);
}

// 原 shader 里的 m2 是常量矩阵
static const float2x2 NTA_M2 = float2x2(0.95534f, 0.29552f, -0.29552f, 0.95534f);

float NTA_Tri(float x)
{
	return clamp(abs(frac(x) - 0.5f), 0.01f, 0.49f);
}

float2 NTA_Tri2(float2 p)
{
	return float2(NTA_Tri(p.x) + NTA_Tri(p.y), NTA_Tri(p.y + NTA_Tri(p.x)));
}

float NTA_Hash21(float2 n)
{
	return frac(sin(dot(n, float2(12.9898f, 4.1414f))) * 43758.5453f);
}

// 磁砖化三角波噪声，5 次迭代，每次用 mm2(time*spd) 旋转 —— 极光会缓慢扭动
float NTA_TriNoise2d(float2 p, float spd, float t)
{
	// 材质 _TimeScale = 0.735，内部 ×25
	const float time = t * (NTA_AURORA_TIME_SCALE * 25.0f);

	float z = 1.8f;
	float z2 = 2.5f;
	float rz = 0.0f;

	p = mul(NTA_MM2(p.x * 0.06f), p);
	float2 bp = p;

	// 5 次固定迭代 —— 展开，避免循环开销
	[unroll]
	for (int i = 0; i < 5; i++)
	{
		float2 dg = NTA_Tri2(bp * 1.85f) * 0.75f;
		dg = mul(NTA_MM2(time * spd), dg);
		p -= dg / z2;

		bp *= 1.3f;
		z2 *= 0.45f;
		z *= 0.42f;

		p *= 1.21f + (rz - 1.0f) * 0.02f;
		rz += NTA_Tri(p.x + NTA_Tri(p.y)) * z;
		p = mul(-NTA_M2, p);
	}

	return clamp(1.0f / pow(rz * 29.0f, 1.3f), 0.0f, 0.55f);
}

// 50 层带状噪声，越往后越高
float4 NTA_Aurora(float3 ro, float3 rd, float t)
{
	float4 col = float4(0, 0, 0, 0);
	float4 avgCol = float4(0, 0, 0, 0);

	// 防止 rd.y 接近 0 时除零（原 shader 用 rd.y*2+0.4 部分掩盖了这点）
	const float denomRaw = rd.y * 2.0f + 0.4f;
	const float denom = (abs(denomRaw) < NTA_EPS)
		? (denomRaw >= 0.0f ? NTA_EPS : -NTA_EPS)
		: denomRaw;

	[loop]
	for (int i = 0; i < NTA_AURORA_LAYERS; i++)
	{
		// 四个只依赖层号的量全部走常量数组（见文件顶部的生成表），
		// 循环里只剩「求交 + 采样噪声 + 累加」
		const float pt = ((NTA_AURORA_HEIGHT + NTA_LAYER_PT_BIAS[i]) - ro.y) / denom - NTA_LAYER_OF[i];

		const float3 bpos = ro + pt * rd;
		const float rzt = NTA_TriNoise2d(bpos.xz, 0.06f, t);

		const float4 col2 = float4(NTA_LAYER_COLOR[i] * rzt, rzt);

		avgCol = lerp(avgCol, col2, 0.5f);
		col += avgCol * NTA_LAYER_WEIGHT[i];
	}

	col *= clamp(rd.y * 15.0f + 0.4f, 0.0f, 1.0f);
	return col * NTA_AURORA_EXPOSURE;
}

// ===========================================================================
// 星云核心 + 星星
// ===========================================================================

float3 NTA_NmzHash33(float3 q)
{
	uint3 p = uint3(int3(q));
	p = p * uint3(374761393u, 1103515245u, 668265263u) + p.zxy + p.yzx;
	p = p.yzx * (p.zxy ^ (p >> 3u));
	return float3(p ^ (p >> 16u)) * (1.0f / float(0xffffffffu));
}

// 点状恒星球面分布
float3 NTA_Stars(float3 p)
{
	float3 c = float3(0, 0, 0);
	const float res = 1024.0f;

	[unroll]
	for (int i = 0; i < 4; i++)
	{
		const float3 q  = frac(p * (0.15f * res)) - 0.5f;
		const float3 id = floor(p * (0.15f * res));
		const float2 rn = NTA_NmzHash33(id).xy;

		float c2 = 1.0f - smoothstep(0.0f, 0.6f, length(q));
		c2 *= step(rn.x, 0.0005f + (float)i * (float)i * 0.001f);
		c += c2 * (lerp(float3(1.0f, 0.49f, 0.1f), float3(0.75f, 0.9f, 1.0f), rn.y) * 0.1f + 0.9f);

		p *= 1.3f;
	}

	return c * c * 0.8f * NTA_STAR_INTENSITY;
}

// 体积步进 + 分形折叠（Kali 的 Star Nest）
float3 NTA_RenderStarNest(float3 dir, float t)
{
	dir *= NTA_ZOOM;

	const float time = t * NTA_SPEED * 0.5f + 0.25f;

	// AutoRotate = 0 → a1 / a2 是编译期常量，cos/sin 在编译期折成立即数
	const float c1 = cos(NTA_A1), s1 = sin(NTA_A1);
	const float c2 = cos(NTA_A2), s2 = sin(NTA_A2);

	float tx;
	tx = dir.x * c1 - dir.z * s1; dir.z = dir.x * s1 + dir.z * c1; dir.x = tx;
	tx = dir.x * c2 - dir.y * s2; dir.y = dir.x * s2 + dir.y * c2; dir.x = tx;

	float3 from = float3(1.0f, 0.5f, 0.5f) + float3(time * 2.0f, time, -2.0f);
	tx = from.x * c1 - from.z * s1; from.z = from.x * s1 + from.z * c1; from.x = tx;
	tx = from.x * c2 - from.y * s2; from.y = from.x * s2 + from.y * c2; from.x = tx;

	float s = 0.1f;
	float fade = 1.0f;
	float3 v = float3(0, 0, 0);

	const float3 tt = NTA_TILE.xxx;
	const float3 tt2 = tt * 2.0f;

	[loop]
	for (int r = 0; r < NTA_VOLSTEPS; r++)
	{
		float3 p = from + s * dir * 0.5f;

		// 无限重复的「瓷砖」折叠（用显式 floor 代替 fmod，见风险 R8）
		p = abs(tt - (p - tt2 * floor(p / tt2)));

		float pa = 0.0f;
		float a = 0.0f;

		// 16 次固定迭代 —— 展开
		[unroll]
		for (int j = 0; j < NTA_ITERATIONS; j++)
		{
			// 反演折叠 —— StarNest 形态的根本来源
			// max(dot,eps)：原 shader 在 dot 趋零时 p 会爆到 inf，
			// 而 cube RT 是 RGBA16F，inf/NaN 会被写进贴图，在材质里变成彩色方块噪点
			p = abs(p) / max(dot(p, p), 1.0e-6f) - NTA_FORMUPARAM;
			a += abs(length(p) - pa);
			pa = length(p);
		}

		// 密度封顶，避免 a*a*a 溢出
		a = min(a, 1.0e4f);

		const float dm = saturate(NTA_DARKMATTER - a * a * 0.001f);
		a = a * a * a;
		if (r > 6)
		{
			fade *= 1.0f - dm;
		}

		v += fade;

		const float3 cp = float3(s, s * s, s * s * s * s);
		float3 nc = NTA_DARK_COLOR;
		nc = lerp(nc, NTA_NEBULA_COLOR, cp.y);
		nc = lerp(nc, NTA_HIGHLIGHT_COLOR, cp.z);
		v += nc * a * NTA_BRIGHTNESS * fade;

		fade *= NTA_DISTFADING;
		s += NTA_STEPSIZE;
	}

	v = lerp(length(v).xxx, v, NTA_SATURATION);
	return v * 0.01f;
}

// ===========================================================================
// 主函数
// ===========================================================================

float3 NTA_SkyColor(float3 rd, float3 ro, float t)
{
	const float fadeBelow = smoothstep(0.0f, 0.01f, abs(rd.y)) * 0.1f + 0.9f;

	float3 col = NTA_RenderStarNest(rd, t);

#if NTA_DEBUG_MODE == 1
	return col;
#endif

	const float3 starCol = NTA_Stars(rd);

#if NTA_DEBUG_MODE == 2
	return starCol;
#endif

	col += starCol;

#if NTA_DEBUG_MODE == 5
	col = float3(0, 0, 0);
#endif

	// 极光只在地平线以上出现
	if (rd.y > 0.0f)
	{
		const float4 aur = smoothstep(0.0f, 1.5f, NTA_Aurora(ro, rd, t)) * fadeBelow;

#if NTA_DEBUG_MODE == 3
		return aur.rgb;
#endif

		col = col * (1.0f - aur.a) + aur.rgb;
	}
	else
	{
#if NTA_DEBUG_MODE == 3
		return float3(0, 0, 0);
#endif

		// 下半球：镜像 + 可选地面雾
		const float3 rdm = float3(rd.x, abs(rd.y), rd.z);
		const float4 aur = smoothstep(0.0f, 2.5f, NTA_Aurora(ro, rdm, t));
		col = col * (1.0f - aur.a * 0.3f) + aur.rgb * 0.3f;

#if NTA_GROUND_FOG
		const float3 pos = ro + ((0.5f - ro.y) / max(rdm.y, 1.0e-3f)) * rdm;
		const float nz2 = NTA_TriNoise2d(pos.xz * float2(0.5f, 0.7f), 0.0f, t);
		col += lerp(float3(0.2f, 0.25f, 0.5f) * 0.08f, float3(0.3f, 0.3f, 0.5f) * 0.7f, nz2 * 0.4f);
#endif
	}

#if NTA_DEBUG_MODE == 4
	return length(col).xxx;
#endif

	// ★ 92% 变暗 —— 决定观感，别漏（风险 R1）
	col = lerp(col, NTA_SKY_DARKEN_COLOR, NTA_SKY_DARKEN);

	return col;
}

// cube face (0..5) + [-1,1] UV -> 方向，采用引擎同款约定（与 ReflectionEnvironmentShaders.usf 一致）
float3 NTA_CubeFaceDirection(float2 ScaledUVs, int InCubeFace)
{
	float3 CubeCoordinates;

	if (InCubeFace == 0)		// +X
	{
		CubeCoordinates = float3(1.0f, -ScaledUVs.y, -ScaledUVs.x);
	}
	else if (InCubeFace == 1)	// -X
	{
		CubeCoordinates = float3(-1.0f, -ScaledUVs.y, ScaledUVs.x);
	}
	else if (InCubeFace == 2)	// +Y
	{
		CubeCoordinates = float3(ScaledUVs.x, 1.0f, ScaledUVs.y);
	}
	else if (InCubeFace == 3)	// -Y
	{
		CubeCoordinates = float3(ScaledUVs.x, -1.0f, -ScaledUVs.y);
	}
	else if (InCubeFace == 4)	// +Z
	{
		CubeCoordinates = float3(ScaledUVs.x, -ScaledUVs.y, 1.0f);
	}
	else						// -Z
	{
		CubeCoordinates = float3(-ScaledUVs.x, -ScaledUVs.y, -1.0f);
	}

	return CubeCoordinates;
}

[numthreads(8, 8, 1)]
void MainCS(uint3 id : SV_DispatchThreadID)
{
	// 按面调度：本次 dispatch 只覆盖 CubeFaceBase .. CubeFaceBase + N - 1 这几个面
	const uint faceIndex = id.z + CubeFaceBase;
	if (id.x >= CubeSize || id.y >= CubeSize || faceIndex >= 6)
	{
		return;
	}

	const float2 ScaledUVs = ((float2(id.xy) + 0.5f) / float(CubeSize)) * 2.0f - 1.0f;

	// -----------------------------------------------------------------------
	// ★ 两个坐标约定必须先对齐，否则天空会整体翻转
	//
	// ① 方向取向：材质的 CameraVector 是「像素 -> 相机」（朝内）
	//    引擎 MaterialTemplate.ush:
	//        Parameters.CameraVector = -WorldRayDirection();
	//    而我们是拿它在 cube 上采样的，所以「屏幕视线方向 d」会去读方向 -d 的 texel。
	//    换句话说：texel v 里必须存 SkyColor(-v)，否则天空被点对称翻转（上下 + 左右同时翻）。
	//    这就是之前「天空上下颠倒」的原因 —— 这里取负号修掉。
	//
	// ② 上方向轴：原始 StarNest / 极光数学是 Y-up（rd.y = 高度），
	//    而 UE 世界是 X 前 / Y 右 / Z 上。不做换算的话 rd.y 实际是「世界 Y 轴（水平）」，
	//    if (rd.y > 0) 切出来的不是地平线，而是一个穿过 Y 轴的竖直平面
	//    （yaw = 0 时正好投影成画面正中的一条硬边）。
	//    换算 (X, Y, Z)_UE -> (X, Z, -Y)：UE 的 +Z(上) 落到 shader 的 +Y(上)；
	//    行列式 = +1，是纯旋转，不会镜像星云。
	//
	// 注意 NTA_RAY_ORIGIN 保持在 shader 的 Y-up 空间里不动（原 shader 就是 (0,0,-6.7)）。
	// -----------------------------------------------------------------------
	const float3 rdView = -normalize(NTA_CubeFaceDirection(ScaledUVs, (int)faceIndex));
	const float3 rd = float3(rdView.x, rdView.z, -rdView.y);

	float3 col = NTA_SkyColor(rd, NTA_RAY_ORIGIN, SkyTime);

	// 兜底：写进 RGBA16F 之前把 inf/NaN 挡掉（否则材质里就是彩色方块噪点）
	col = clamp(col, 0.0f, 8.0f);
	col = all(col == col) ? col : float3(0, 0, 0);

	RWOutput[uint3(id.x, id.y, faceIndex)] = float4(col, 1.0f);
}
